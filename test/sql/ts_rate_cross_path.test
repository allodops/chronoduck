# =============================================================================
# A sliding multi-point grid with a reset that must NOT be seen from a
# neighbouring window — the one case a single-grid-point dataset can never
# exercise: whether a bug lets a reset (or a sample) leak across a window
# boundary it doesn't belong to.
# =============================================================================

# Three overlapping windows (width 100, step 50) over one series with one
# reset (100 -> 90 at t=80..130 is not a reset; 90 -> 50 at t=80/t=130 is).
# anchor=100, window (0,100]: samples t=30 (100), t=80 (90); no reset
# (90 < 100 is a drop -> IS a reset: 100 + (90-100) = 90 after extrapolation
# -> rate 1.8). anchor=150, window (50,150]: samples t=80 (90), t=130 (50);
# reset (50 < 90) -> delta = 90 + (50-90) = 50 -> rate 1.0. anchor=200,
# window (100,200]: samples t=130 (50), t=180 (60); no reset -> delta =
# 60-50 = 10 -> rate 0.2. The t=30 sample must not contribute a spurious
# reset to anchor=150's window (t=30 falls outside it) — the bug this
# dataset traps is exactly a global, un-windowed reset scan.

statement ok
CREATE TEMP TABLE sliding_reset_dataset AS SELECT * FROM (VALUES
    (1::UBIGINT, TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (30) MICROSECOND, 100.0::DOUBLE, NULL::TIMESTAMP),
    (1::UBIGINT, TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (80) MICROSECOND, 90.0::DOUBLE, NULL::TIMESTAMP),
    (1::UBIGINT, TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (130) MICROSECOND, 50.0::DOUBLE, NULL::TIMESTAMP),
    (1::UBIGINT, TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (180) MICROSECOND, 60.0::DOUBLE, NULL::TIMESTAMP)
) AS t(series_id, ts, value, start_ts);

query I
SELECT list(rate ORDER BY ts) FROM ts_rate_reference('sliding_reset_dataset',
    TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (100) MICROSECOND,
    TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (200) MICROSECOND, 50, 100);
----
[1.8, 1.0, 0.2]

query I
SELECT ts_rate(ts, value,
    TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (100) MICROSECOND,
    TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (200) MICROSECOND, 50, 100)
FROM sliding_reset_dataset;
----
[1.8, 1.0, 0.2]

query I
SELECT "values" FROM ts_rate(
    (SELECT series_id, ts, value FROM sliding_reset_dataset),
    TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (100) MICROSECOND,
    TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (200) MICROSECOND, 50, 100);
----
[1.8, 1.0, 0.2]
