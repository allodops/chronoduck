# rate/threshold-single-sample-with-st.yaml
statement ok
CREATE TEMP TABLE single_with_st_dataset AS SELECT * FROM (VALUES
    (1::UBIGINT, TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (100) MICROSECOND, 5.0::DOUBLE,
     TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (80) MICROSECOND)
) AS t(series_id, ts, value, start_ts);

query I
