# rate/threshold-single-sample-without-st.yaml — one sample, no start
# timestamp: "one sample -> no value" is true only when no start-timestamp
# role is bound at all.
statement ok
CREATE TEMP TABLE single_without_st_dataset AS SELECT * FROM (VALUES
    (1::UBIGINT, TIMESTAMP '2024-01-01 00:00:00' + INTERVAL (50) MICROSECOND, 10.0::DOUBLE, NULL::TIMESTAMP)
) AS t(series_id, ts, value, start_ts);

