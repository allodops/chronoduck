# name: test/sql/ts_grid_index.test
# description: ts_grid_index(t, start, step) boundary cases
# group: [sql]

require chronoduck

# step of one unit (1 microsecond) — t five units after start
query I
SELECT ts_grid_index(TIMESTAMP '2024-01-01 00:00:00.000005', TIMESTAMP '2024-01-01 00:00:00', 1);
----
5

# t before start, evenly-divisible offset (remainder 0, so floor and
# truncating division agree here — the block below is the one that
# actually distinguishes floor from truncation)
query I
SELECT ts_grid_index(TIMESTAMP '2023-12-31 23:59:59', TIMESTAMP '2024-01-01 00:00:00', 1000000);
----
-1

# t < start with a non-zero remainder — exercises FloorDiv's decrement
# branch specifically: truncating division would wrongly give -1
# (floor(-1.5) = -2, but -1500000 / 1000000 truncates to -1 in C++)
query I
SELECT ts_grid_index(TIMESTAMP '2023-12-31 23:59:58.5', TIMESTAMP '2024-01-01 00:00:00', 1000000);
----
-2

# t = start
query I
SELECT ts_grid_index(TIMESTAMP '2024-01-01 00:00:00', TIMESTAMP '2024-01-01 00:00:00', 1000000);
----
0

# t exactly on a grid point past start
query I
SELECT ts_grid_index(TIMESTAMP '2024-01-01 00:00:03', TIMESTAMP '2024-01-01 00:00:00', 1000000);
----
3

# t just below a grid point (one microsecond short of the next boundary)
query I
SELECT ts_grid_index(TIMESTAMP '2024-01-01 00:00:02.999999', TIMESTAMP '2024-01-01 00:00:00', 1000000);
----
2

# step must be positive
statement error
SELECT ts_grid_index(TIMESTAMP '2024-01-01 00:00:00', TIMESTAMP '2024-01-01 00:00:00', 0);
----
step must be positive

# t and start at the extremes of DuckDB's representable TIMESTAMP range
# (roughly [-290308-12-22, 294247-01-01]): t.value - grid_start.value is
# ~1.84e19 microseconds, which overflows int64_t (max ~9.22e18) before any
# division happens. The correct floor-divided index (~1.84e10) fits BIGINT
# comfortably, so this must return that index, not silently wrap.
query I
SELECT ts_grid_index(TIMESTAMP '294247-01-01 00:00:00', TIMESTAMP '-290308-12-22 00:00:00', 1000000000);
----
18446743267

# Same extremes, but step = 1: even the mathematically correct index
# (~1.84e19) doesn't fit in BIGINT, so this must raise a clear error
# instead of returning a wrapped/truncated value.
statement error
SELECT ts_grid_index(TIMESTAMP '294247-01-01 00:00:00', TIMESTAMP '-290308-12-22 00:00:00', 1);
----
overflows BIGINT
