# name: test/sql/ts_grid.test
# description: ts_grid(start, end, step) table function — one TIMESTAMP row per grid point
# group: [sql]

require chronoduck

# A grid of three points, step = 1 microsecond.
query I
SELECT * FROM ts_grid(TIMESTAMP '2024-01-01 00:00:00', TIMESTAMP '2024-01-01 00:00:00.000002', 1);
----
2024-01-01 00:00:00
2024-01-01 00:00:00.000001
2024-01-01 00:00:00.000002

# A single-point grid (start == end).
query I
SELECT * FROM ts_grid(TIMESTAMP '2024-01-01 00:00:00', TIMESTAMP '2024-01-01 00:00:00', 1000000);
----
2024-01-01 00:00:00

# step must be positive.
statement error
SELECT * FROM ts_grid(TIMESTAMP '2024-01-01 00:00:00', TIMESTAMP '2024-01-01 00:00:00', 0);
----
step must be positive

# step must evenly divide end - start.
statement error
SELECT * FROM ts_grid(TIMESTAMP '2024-01-01 00:00:00', TIMESTAMP '2024-01-01 00:00:00.000010', 3);
----
evenly divide

# end must be >= start.
statement error
SELECT * FROM ts_grid(TIMESTAMP '2024-01-01 00:00:00', TIMESTAMP '2023-12-31 23:59:59.999999', 1);
----
end must be >=
