{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "duckdb/community-extensions description.yml",
  "description": "duckdb/community-extensions publishes no standalone JSON Schema file for description.yml — its shape is enforced in code, by scripts/build.py (extension.name, repo.github and repo.ref are read without a fallback, i.e. required) and scripts/generate_extensions_json.py (every other field, read via .get() with no required check). This file is our own hand-derived encoding of that behavior, for scripts/description-validate.mjs to check against; see the sibling .source file for the exact upstream commits it was derived from.",
  "type": "object",
  "required": ["extension", "repo"],
  "properties": {
    "extension": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "language": { "type": "string" },
        "build": { "type": "string" },
        "license": { "type": "string" },
        "maintainers": { "type": "array", "items": { "type": "string" } },
        "requires_toolchains": { "type": "string" },
        "excluded_platforms": { "type": "string" },
        "opt_in_platforms": { "type": "string" },
        "custom_toolchain_script": { "type": "string" },
        "vcpkg_url": { "type": "string" },
        "vcpkg_commit": { "type": "string" },
        "test_config": { "type": "object" }
      },
      "additionalProperties": true
    },
    "repo": {
      "type": "object",
      "required": ["github", "ref"],
      "properties": {
        "github": { "type": "string" },
        "ref": { "type": "string" },
        "ref_next": { "type": "string" },
        "canonical_name": { "type": "string" },
        "andium": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "docs": {
      "type": "object",
      "properties": {
        "hello_world": { "type": "string" },
        "extended_description": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
